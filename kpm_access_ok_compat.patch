+/* Compat: pre-5.0 kernels use access_ok(type, addr, size); the "type"
+ * argument (VERIFY_READ/VERIFY_WRITE) is ignored internally on arm64
+ * anyway, so passing VERIFY_READ is safe for both read and write checks.
+ * 5.0+ kernels dropped the type argument entirely. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+#define ksu_kpm_access_ok(addr, size) access_ok(VERIFY_READ, (addr), (size))
+#else
+#define ksu_kpm_access_ok(addr, size) access_ok((addr), (size))
+#endif
+
 #define KPM_NAME_LEN 32
 #define KPM_ARGS_LEN 1024
 
