diff --git a/kernel/kernel_compat.h b/kernel/kernel_compat.h
--- a/kernel/kernel_compat.h
+++ b/kernel/kernel_compat.h
@@ -3,6 +3,92 @@
 
 #include <linux/fs.h>
 #include <linux/version.h>
+#include <linux/uaccess.h>
+
+/*
+ * strncpy_from_user_nofault / copy_from_user_nofault / copy_to_user_nofault
+ * were only added to the kernel around 5.8. Older non-GKI trees (e.g.
+ * cepheus 4.14) don't have them at all, which shows up as an implicit
+ * declaration build error. Provide equivalent fallbacks using the
+ * classic get_fs()/set_fs()/pagefault_disable() pattern.
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0) && !defined(KSU_HAS_STRNCPY_FROM_USER_NOFAULT)
+static inline long strncpy_from_user_nofault(char *dst, const void __user *unsafe_addr, long count)
+{
+    mm_segment_t old_fs;
+    long ret;
+
+    if (unlikely(count <= 0))
+        return 0;
+
+    old_fs = get_fs();
+    set_fs(USER_DS);
+    pagefault_disable();
+    ret = strncpy_from_user(dst, unsafe_addr, count);
+    pagefault_enable();
+    set_fs(old_fs);
+
+    if (ret >= count) {
+        ret = count;
+        dst[ret - 1] = '\0';
+    } else if (ret > 0) {
+        ret++;
+    }
+
+    return ret;
+}
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0) && !defined(KSU_HAS_COPY_FROM_USER_NOFAULT)
+static inline long copy_from_user_nofault(void *dst, const void __user *src, size_t size)
+{
+    mm_segment_t old_fs;
+    long ret;
+
+    old_fs = get_fs();
+    set_fs(USER_DS);
+    pagefault_disable();
+    ret = __copy_from_user_inatomic(dst, src, size);
+    pagefault_enable();
+    set_fs(old_fs);
+
+    return ret ? -EFAULT : 0;
+}
+
+static inline long copy_to_user_nofault(void __user *dst, const void *src, size_t size)
+{
+    mm_segment_t old_fs;
+    long ret;
+
+    old_fs = get_fs();
+    set_fs(USER_DS);
+    pagefault_disable();
+    ret = __copy_to_user_inatomic(dst, src, size);
+    pagefault_enable();
+    set_fs(old_fs);
+
+    return ret ? -EFAULT : 0;
+}
+#endif
+
+/*
+ * fallthrough: added to the kernel around 4.19/5.x
+ * (linux/compiler_attributes.h). Older trees like cepheus 4.14 don't
+ * have it, causing "use of undeclared identifier 'fallthrough'".
+ */
+#ifndef fallthrough
+#ifndef __has_attribute
+#define __has_attribute(x) __GCC4_has_attribute_##x
+#define __GCC4_has_attribute___fallthrough__ 0
+#endif
+#if __has_attribute(__fallthrough__)
+#define fallthrough __attribute__((__fallthrough__))
+#else
+#define fallthrough \
+    do {            \
+    } while (0) /* fallthrough */
+#endif
+#endif
 
